<section class="area-dashboard dev-project-board" aria-label="Developer project progress">
    <header class="area-progress-card area-progress-dev">
        <div class="area-orb" aria-hidden="true">&lt;/&gt;</div>
        <div class="area-progress-copy">
            <span class="area-kicker">Developer track</span>
            <h2>Master Dev</h2>
            <p>Code, architecture, automation, and products that solve real operational problems.</p>
        </div>

        <div class="area-score">
            <span>Points</span>
            <strong>1280 <small>/ 1500</small></strong>
            <div class="area-xp-bar" aria-hidden="true"><i class="xp-85"></i></div>
            <em>85% toward the next level</em>
        </div>

        <dl class="area-stats">
            <div>
                <dt>Level</dt>
                <dd>21</dd>
            </div>
            <div>
                <dt>Projects</dt>
                <dd>12</dd>
            </div>
            <div>
                <dt>Studies</dt>
                <dd>34</dd>
            </div>
            <div>
                <dt>Streak</dt>
                <dd>28d</dd>
            </div>
            <div>
                <dt>Badges</dt>
                <dd>8</dd>
            </div>
        </dl>
    </header>

    <div class="project-grid xp-project-list">
        <details class="project-card xp-project-card dev-card" open>
            <summary>
                <div class="project-card-main">
                    <img src="~/img/ProjectsIMGs/ZeroPaper-thumb.png"
                         asp-append-version="true"
                         alt="ZeroPaper preview"
                         class="project-emblem"
                         width="108"
                         height="108"
                         loading="lazy"
                         decoding="async">

                    <div class="project-card-copy">
                        <span class="project-rank">Featured product</span>
                        <h3>ZeroPaper</h3>
                        <p>Restaurant SaaS &middot; QR ordering &middot; Kitchen flow &middot; Operations</p>
                    </div>
                </div>

                <div class="project-card-score">
                    <strong>1280 <span>/ 1500</span></strong>
                    <div class="area-xp-bar" aria-hidden="true"><i class="xp-85"></i></div>
                </div>
            </summary>

            <div class="project-body premium-project-body">
                <p>
                    A restaurant operating system designed to connect menu management, tables, QR ordering,
                    kitchen flow, printing, and internal routines in a single platform.
                </p>
                <p>
                    It is the strongest project in the portfolio because it combines product thinking, backend structure,
                    multi-user workflow, modular organization, and real operational demands.
                </p>

                <ul class="project-badges" aria-label="ZeroPaper focus areas">
                    <li>SaaS for restaurants</li>
                    <li>QR Code orders</li>
                    <li>Kitchen flow</li>
                    <li>Operations</li>
                </ul>

                <div class="project-links">
                    <a href="https://github.com/AlexssanderLX/ZeroPaper"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                    </a>
                    <a href="https://zeropaperflow.com.br"
                       target="_blank"
                       rel="noopener noreferrer">
                        Project site
                    </a>
                </div>
            </div>
        </details>

        <details class="project-card xp-project-card dev-card">
            <summary>
                <div class="project-card-main">
                    <img src="~/img/ProjectsIMGs/StoreFlow-logo.svg"
                         asp-append-version="true"
                         alt="StoreFlow logo"
                         class="project-emblem"
                         width="108"
                         height="108"
                         loading="lazy"
                         decoding="async">

                    <div class="project-card-copy">
                        <span class="project-rank">Operations system</span>
                        <h3>StoreFlow</h3>
                        <p>Internal operations &middot; Shortage records &middot; Store workflow</p>
                    </div>
                </div>

                <div class="project-card-score">
                    <strong>1040 <span>/ 1500</span></strong>
                    <div class="area-xp-bar" aria-hidden="true"><i class="xp-69"></i></div>
                </div>
            </summary>

            <div class="project-body premium-project-body">
                <p>
                    An internal application created to record product shortages, organize daily operational routines,
                    and reduce disorder in repetitive store processes.
                </p>
                <p>
                    Its value comes from turning an operational pain point into a cleaner, more centralized,
                    and easier-to-track workflow.
                </p>

                <ul class="project-badges" aria-label="StoreFlow focus areas">
                    <li>Internal operations</li>
                    <li>Shortage records</li>
                    <li>Store workflow</li>
                </ul>

                <div class="project-links">
                    <a href="https://github.com/AlexssanderLX/StoreFlow"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                    </a>
                </div>
            </div>
        </details>

        <details class="project-card xp-project-card dev-card">
            <summary>
                <div class="project-card-main">
                    <img src="~/img/ProjectsIMGs/LedgerFlow-logo.png"
                         asp-append-version="true"
                         alt="LedgerFlow logo"
                         class="project-emblem"
                         width="108"
                         height="108"
                         loading="lazy"
                         decoding="async">

                    <div class="project-card-copy">
                        <span class="project-rank">Business workflow</span>
                        <h3>LedgerFlow</h3>
                        <p>Accounting workflow &middot; Documents &middot; Fiscal routines</p>
                    </div>
                </div>

                <div class="project-card-score">
                    <strong>940 <span>/ 1500</span></strong>
                    <div class="area-xp-bar" aria-hidden="true"><i class="xp-63"></i></div>
                </div>
            </summary>

            <div class="project-body premium-project-body">
                <p>
                    A platform built to organize client records, document modules, DAS and DEFIS drafts,
                    and the operational visibility of a small accounting office in a cleaner structure.
                </p>
                <p>
                    It shows a more formal and document-heavy side of my development work:
                    process modeling, information organization, and consistency in administrative routines.
                </p>

                <ul class="project-badges" aria-label="LedgerFlow focus areas">
                    <li>Accounting workflow</li>
                    <li>Documents</li>
                    <li>Fiscal routines</li>
                </ul>

                <div class="project-links">
                    <a href="https://github.com/AlexssanderLX/LedgerFlow"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                    </a>
                </div>
            </div>
        </details>
    </div>
</section>
