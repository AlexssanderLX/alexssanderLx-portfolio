@model IReadOnlyList<ClientBlog.Models.Composition>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Music";
    ViewData["Description"] = ViewData["Description"] ?? "Piano, composition and YourRhythm Studio. A practical music page with virtual piano and original pieces.";

    var octaves = new[] { 3, 4, 5 };
    var whites = new[] { "C", "D", "E", "F", "G", "A", "B" };
    var hasBlack = new System.Collections.Generic.Dictionary<string, bool> {
        ["C"] = true, ["D"] = true, ["E"] = false,
        ["F"] = true, ["G"] = true, ["A"] = true, ["B"] = false
    };
    var compositions = Model.OrderByDescending(comp => comp.IsFeatured).ThenBy(comp => comp.Order).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/music.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/music-piano.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/experience.css" asp-append-version="true" />
}

<div class="music-page music-page--clean experience-page experience-page--music" data-experience-page>
    <section class="music-clean-hero site-section" aria-labelledby="music-h1">
        <div class="site-shell music-clean-hero__grid">
            <div class="music-clean-copy" data-reveal>
                <span class="ui-kicker music-kicker">Piano / Product / Composition</span>
                <h1 class="ui-title" id="music-h1">
                    Piano on top. <span class="ui-gradient-text">Music below.</span>
                </h1>
                <p class="ui-description">
                    A focused music space: try the piano, visit YourRhythm Studio and listen to original pieces.
                </p>
                <div class="ui-actions">
                    <a class="ui-button ui-button--primary" href="#music-piano">Play piano</a>
                    <a class="ui-button ui-button--ghost" href="#music-compositions">Compositions</a>
                </div>
            </div>

            <a class="music-studio-panel ui-card"
               href="https://yourrhythmstudio.com.br"
               target="_blank"
               rel="noopener noreferrer"
               data-reveal
               aria-label="Visit YourRhythm Studio">
                <span class="music-studio-panel__status">Live product</span>
                <img src="~/img/ProjectsIMGs/YourRhythmStudio-Logo.png"
                     asp-append-version="true"
                     alt="YourRhythm Studio logo"
                     width="92"
                     height="92"
                     loading="lazy"
                     decoding="async" />
                <strong>YourRhythm Studio</strong>
                <p>Platform for teachers and music schools to organize students, lessons, repertoire and weekly practice.</p>
                <span class="music-studio-panel__link">Visit platform</span>
            </a>
        </div>
    </section>

    <section class="music-piano-section music-piano-section--clean site-section" id="music-piano" aria-labelledby="music-piano-heading">
        <div class="site-shell">
            <div class="music-piano-intro" data-reveal>
                <span class="ui-kicker music-kicker">Virtual piano</span>
                <h2 class="music-piano-intro-title" id="music-piano-heading">Try the piano.</h2>
                <p class="music-piano-intro-desc">Click, tap or use your keyboard. Keep it simple, musical and fast.</p>
            </div>

            <div class="pv-controls" data-reveal>
                <div class="pv-vol-wrap">
                    <svg class="pv-vol-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                    </svg>
                    <label for="pvVolume" class="sr-only">Volume</label>
                    <input type="range" id="pvVolume" min="0" max="1" step="0.05" value="0.65" aria-label="Piano volume" />
                </div>
                <div class="pv-labels-wrap">
                    <label class="pv-checkbox" aria-label="Show note labels">
                        <input type="checkbox" id="pvLabels" />
                        <span class="pv-checkbox-track" aria-hidden="true"></span>
                    </label>
                    <span>Show notes</span>
                </div>
            </div>

            <div class="pv-piano-outer" data-reveal>
                <div class="pv-octave-header" aria-hidden="true">
                    <span class="pv-octave-label">C3</span>
                    <span class="pv-octave-label">C4 middle</span>
                    <span class="pv-octave-label">C5</span>
                </div>
                <div class="pv-piano-scroll">
                    <div id="pvPiano" class="pv-piano" role="group" aria-label="Virtual piano, use click or keyboard">
                        @foreach (var oct in octaves)
                        {
                            foreach (var note in whites)
                            {
                                var noteName = $"{note}{oct}";
                                <div class="pv-key pv-wkey"
                                     data-note="@noteName"
                                     tabindex="0"
                                     role="button"
                                     aria-pressed="false"
                                     aria-label="@noteName">
                                    <span class="pv-wlabel" aria-hidden="true">@note<sub>@oct</sub></span>
                                    @if (hasBlack[note])
                                    {
                                        var bNote = $"{note}#{oct}";
                                        <div class="pv-key pv-bkey"
                                             data-note="@bNote"
                                             tabindex="0"
                                             role="button"
                                             aria-pressed="false"
                                             aria-label="@bNote">
                                            <span class="pv-blabel" aria-hidden="true">@note#</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <p class="pv-hint" id="pvHint" aria-live="polite">
                    Click or press a key to start
                </p>
            </div>

            <div class="music-track-bar" data-reveal aria-label="Background track">
                <div class="music-track-info">
                    <span class="music-track-name">Beat_1 - YourRhythm Studio</span>
                    <p class="music-track-meta">Enable the track and play along.</p>
                </div>
                <button id="musicTrackBtn"
                        type="button"
                        aria-pressed="false"
                        aria-label="Enable background track">
                    <span class="track-icon" aria-hidden="true">♪</span>
                    <span class="track-label">Enable track</span>
                </button>
            </div>
        </div>
    </section>

    <section class="music-compositions site-section" id="music-compositions" aria-labelledby="music-comp-heading">
        <div class="site-shell">
            <div class="music-section-head" data-reveal>
                <span class="ui-kicker music-kicker">Compositions</span>
                <h2 class="ui-title experience-title-sm" id="music-comp-heading">Original pieces.</h2>
                <p class="ui-description">Only the music list. More pieces can be added here without redesigning the page.</p>
            </div>

            <ul class="music-comp-list music-comp-list--clean" role="list">
                @foreach (var comp in compositions)
                {
                    <li class="music-comp-card ui-card" data-reveal>
                        <div class="music-comp-emblem" aria-hidden="true">♪</div>
                        <div class="music-comp-body">
                            <span class="music-comp-type">@comp.Type / @comp.Year</span>
                            <h3 class="music-comp-name">@comp.Name</h3>
                            <p class="music-comp-desc">@comp.Description</p>
                            @if (comp.Tags.Any())
                            {
                                <ul class="music-comp-tags" aria-label="Tags for @comp.Name">
                                    @foreach (var tag in comp.Tags.Take(3))
                                    {
                                        <li class="music-comp-tag">@tag</li>
                                    }
                                </ul>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(comp.BandLabUrl))
                        {
                            <div class="music-comp-actions">
                                <a class="music-listen-link"
                                   href="@comp.BandLabUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Listen
                                </a>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/experience-motion.js" asp-append-version="true"></script>
    <script src="~/js/music-piano.js" asp-append-version="true"></script>
}
