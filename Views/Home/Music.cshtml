@model IReadOnlyList<ClientBlog.Models.Composition>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Música";
    ViewData["Description"] = ViewData["Description"] ?? "Piano, composição, jazz e aulas. Técnica, percepção e criatividade — do repertório clássico à composição original.";

    var octaves = new[] { 3, 4, 5 };
    var whites  = new[] { "C", "D", "E", "F", "G", "A", "B" };
    var hasBlack = new System.Collections.Generic.Dictionary<string, bool> {
        ["C"] = true, ["D"] = true, ["E"] = false,
        ["F"] = true, ["G"] = true, ["A"] = true, ["B"] = false
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/music.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/music-piano.css" asp-append-version="true" />
}

<div class="music-page">

    <!-- ── Hero ── -->
    <section class="music-hero" aria-labelledby="music-h1">
        <div class="site-shell">
            <div class="music-hero-inner">
                <div class="music-hero-meta" data-reveal>
                    <span class="ui-kicker music-kicker">Piano · Composição · Ensino</span>
                </div>

                <h1 class="ui-title" id="music-h1" data-reveal>
                    Música como linguagem, <br>
                    <span class="ui-gradient-text">técnica como ferramenta.</span>
                </h1>

                <p class="ui-description" data-reveal>
                    Pianista, compositor e professor. Desenvolvo repertório, técnica e percepção
                    com foco em evolução real — do básico ao jazz e à composição original.
                    Cada aula parte do que o aluno quer aprender.
                </p>

                <div class="ui-actions" data-reveal>
                    <a class="ui-button ui-button--primary"
                       asp-controller="Home"
                       asp-action="Contact">
                        Solicitar aulas
                    </a>
                    <a class="ui-button ui-button--ghost" href="#music-compositions">
                        Ouvir composições
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Piano Virtual ── -->
    <section class="music-piano-section site-section" id="music-piano" aria-labelledby="music-piano-heading">
        <div class="site-shell">

            <div class="music-piano-intro" data-reveal>
                <h2 class="music-piano-intro-title" id="music-piano-heading">
                    Experimente o piano.
                </h2>
                <p class="music-piano-intro-desc">
                    Teclado virtual com síntese de áudio real — clique, toque ou use o teclado.
                    Esta é a mesma engine embutida no <a href="#music-studio" style="color:var(--color-cyan);text-decoration:none;">Your Rhythm Studio</a>.
                </p>
            </div>

            <!-- Tutorial cards -->
            <div class="pv-tut-grid" data-reveal>
                <div class="pv-tut-card">
                    <div class="pv-tut-icon" aria-hidden="true">🖱️</div>
                    <h3>Clique ou toque</h3>
                    <p>Clique nas teclas brancas e pretas para tocar. Funciona com mouse, touchscreen e stylus.</p>
                </div>
                <div class="pv-tut-card">
                    <div class="pv-tut-icon" aria-hidden="true">⌨️</div>
                    <h3>Teclado físico</h3>
                    <p>Use o teclado do computador para tocar — mapeado para oitava central. Veja os atalhos abaixo.</p>
                </div>
                <div class="pv-tut-card">
                    <div class="pv-tut-icon" aria-hidden="true">🎵</div>
                    <h3>Trilha + piano</h3>
                    <p>Ative a trilha sonora ao lado e improvise junto — criada originalmente para o Your Rhythm Studio.</p>
                </div>
            </div>

            <!-- Controles -->
            <div class="pv-controls" data-reveal>
                <div class="pv-vol-wrap">
                    <svg class="pv-vol-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                    </svg>
                    <label for="pvVolume" class="sr-only">Volume</label>
                    <input type="range" id="pvVolume" min="0" max="1" step="0.05" value="0.65" aria-label="Volume do piano" />
                </div>
                <div class="pv-labels-wrap">
                    <label class="pv-checkbox" aria-label="Mostrar notas">
                        <input type="checkbox" id="pvLabels" />
                        <span class="pv-checkbox-track" aria-hidden="true"></span>
                    </label>
                    <span>Mostrar notas</span>
                </div>
            </div>

            <!-- Piano -->
            <div class="pv-piano-outer" data-reveal>
                <div class="pv-octave-header" aria-hidden="true">
                    <span class="pv-octave-label">← C3</span>
                    <span class="pv-octave-label">C4 (central) →</span>
                    <span class="pv-octave-label">C5 →</span>
                </div>
                <div class="pv-piano-scroll">
                    <div id="pvPiano" class="pv-piano" role="group" aria-label="Piano virtual — use clique ou teclado">
                        @foreach (var oct in octaves)
                        {
                            foreach (var note in whites)
                            {
                                var noteName = $"{note}{oct}";
                                <div class="pv-key pv-wkey"
                                     data-note="@noteName"
                                     tabindex="0"
                                     role="button"
                                     aria-pressed="false"
                                     aria-label="@noteName">
                                    <span class="pv-wlabel" aria-hidden="true">@note<sub>@oct</sub></span>
                                    @if (hasBlack[note])
                                    {
                                        var bNote = $"{note}#{oct}";
                                        <div class="pv-key pv-bkey"
                                             data-note="@bNote"
                                             tabindex="0"
                                             role="button"
                                             aria-pressed="false"
                                             aria-label="@bNote">
                                            <span class="pv-blabel" aria-hidden="true">@note#</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <p class="pv-hint" id="pvHint" aria-live="polite">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    Clique ou pressione uma tecla para começar
                </p>
            </div>

            <!-- Atalhos de teclado -->
            <details class="pv-shortcuts" data-reveal>
                <summary>Atalhos de teclado</summary>
                <div class="pv-shortcut-body">
                    <div class="pv-shortcut-row">
                        <span class="pv-sc-item"><kbd class="pv-sc-key">A</kbd> C4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">W</kbd> C#4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">S</kbd> D4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">E</kbd> D#4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">D</kbd> E4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">F</kbd> F4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">T</kbd> F#4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">G</kbd> G4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">Y</kbd> G#4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">H</kbd> A4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">U</kbd> A#4</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">J</kbd> B4</span>
                    </div>
                    <div class="pv-shortcut-row">
                        <span class="pv-sc-item"><kbd class="pv-sc-key">K</kbd> C5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">O</kbd> C#5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">L</kbd> D5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">P</kbd> D#5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">;</kbd> E5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">Z</kbd> F5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">X</kbd> G5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">C</kbd> A5</span>
                        <span class="pv-sc-item"><kbd class="pv-sc-key">V</kbd> B5</span>
                    </div>
                </div>
            </details>

            <!-- Trilha sonora -->
            <div class="music-track-bar" data-reveal aria-label="Trilha sonora">
                <div class="music-track-info">
                    <span class="music-track-name">Beat_1 — Your Rhythm Studio</span>
                    <p class="music-track-meta">Beat original criado para a plataforma. Clique para ativar e tocar junto.</p>
                </div>
                <button id="musicTrackBtn"
                        type="button"
                        aria-pressed="false"
                        aria-label="Ativar trilha sonora">
                    <span class="track-icon" aria-hidden="true">♪</span>
                    <span class="track-label">Ativar trilha</span>
                </button>
            </div>

        </div>
    </section>

    <!-- ── Metodologia ── -->
    <section class="music-methodology site-section" id="music-methodology" aria-labelledby="music-method-heading">
        <div class="site-shell">
            <div class="music-section-head" data-reveal>
                <span class="ui-kicker">Abordagem</span>
                <h2 class="ui-title" id="music-method-heading" style="font-size: var(--step-2);">
                    Seis pilares que estruturam o aprendizado.
                </h2>
                <p class="ui-description">
                    Não existe fórmula única — mas existe uma sequência que funciona quando os fundamentos estão claros.
                </p>
            </div>

            <ul class="music-pillars" role="list">
                <li class="music-pillar ui-card" data-reveal data-pillar="1">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">01</div>
                    <h3 class="music-pillar-title">Técnica</h3>
                    <p class="music-pillar-desc">Postura, articulação, controle de dinâmica e independência das mãos — base para tudo que vem depois.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
                <li class="music-pillar ui-card" data-reveal data-pillar="2">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">02</div>
                    <h3 class="music-pillar-title">Percepção</h3>
                    <p class="music-pillar-desc">Ouvir o que se toca. Ritmo, afinação, fraseado e a capacidade de reproduzir o que se imagina.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
                <li class="music-pillar ui-card" data-reveal data-pillar="3">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">03</div>
                    <h3 class="music-pillar-title">Repertório</h3>
                    <p class="music-pillar-desc">Peças que motivam e desafiam ao mesmo tempo — escolhidas junto com o aluno, não impostas.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
                <li class="music-pillar ui-card" data-reveal data-pillar="4">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">04</div>
                    <h3 class="music-pillar-title">Teoria</h3>
                    <p class="music-pillar-desc">Entender o que se toca — escalas, acordes, progressões e leitura. Teoria aplicada ao instrumento.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
                <li class="music-pillar ui-card" data-reveal data-pillar="5">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">05</div>
                    <h3 class="music-pillar-title">Harmonia</h3>
                    <p class="music-pillar-desc">Jazz, voicings, reharmonização e tensões que ampliam a paleta sonora — para quem quer ir além do básico.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
                <li class="music-pillar ui-card" data-reveal data-pillar="6">
                    <div class="music-pillar-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                    </div>
                    <div class="music-pillar-num" aria-hidden="true">06</div>
                    <h3 class="music-pillar-title">Composição</h3>
                    <p class="music-pillar-desc">Transformar ideias em música — estrutura, desenvolvimento temático e escrita para piano.</p>
                    <div class="music-pillar-glow" aria-hidden="true"></div>
                </li>
            </ul>
        </div>
    </section>

    <!-- ── Composições ── -->
    <section class="music-compositions site-section" id="music-compositions" aria-labelledby="music-comp-heading">
        <div class="site-shell">
            <div class="music-section-head" data-reveal>
                <span class="ui-kicker">Composições</span>
                <h2 class="ui-title" id="music-comp-heading" style="font-size: var(--step-2);">
                    Peças originais.
                </h2>
                <p class="ui-description">
                    Composições para piano criadas como exploração — de contraste harmônico, narrativa emocional e expressão pessoal.
                </p>
            </div>

            <ul class="music-comp-list" role="list">
                @foreach (var comp in Model)
                {
                    <li class="music-comp-card ui-card" data-reveal>
                        <div class="music-comp-emblem" aria-hidden="true">♬</div>
                        <div class="music-comp-body">
                            <span class="music-comp-type">@comp.Type · @comp.Year</span>
                            <h3 class="music-comp-name">@comp.Name</h3>
                            <p class="music-comp-desc">@comp.Description</p>
                            @if (comp.Tags.Any())
                            {
                                <ul class="music-comp-tags" aria-label="Tags de @comp.Name">
                                    @foreach (var tag in comp.Tags)
                                    {
                                        <li class="music-comp-tag">@tag</li>
                                    }
                                </ul>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(comp.BandLabUrl))
                        {
                            <div class="music-comp-actions">
                                <a class="music-listen-link"
                                   href="@comp.BandLabUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    ♪ Ouvir no BandLab
                                </a>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>

    <!-- ── Aulas ── -->
    <section class="music-lessons site-section" id="music-lessons" aria-labelledby="music-lessons-heading">
        <div class="site-shell">
            <div class="music-lessons-inner">
                <div class="music-lessons-copy" data-reveal>
                    <span class="ui-kicker">Aulas</span>
                    <h2 class="music-lessons-title" id="music-lessons-heading">
                        Aulas de piano <br>para o seu momento.
                    </h2>
                    <p class="music-lessons-desc">
                        Seja para começar do zero, retomar depois de um tempo parado ou aprofundar em jazz e composição —
                        o ponto de partida é onde você está agora.
                    </p>
                    <p class="music-lessons-desc">
                        Sem preço fixo listado aqui — porque a modalidade, frequência e foco variam por aluno.
                        Entre em contato para conversarmos.
                    </p>
                    <div class="ui-actions">
                        <a class="ui-button ui-button--primary"
                           asp-controller="Home"
                           asp-action="Contact">
                            Solicitar aulas
                        </a>
                    </div>
                </div>

                <ul class="music-lesson-areas" role="list" data-reveal>
                    <li class="music-lesson-area ui-card">
                        <div class="music-lesson-area-icon" aria-hidden="true">T</div>
                        <div class="music-lesson-area-body">
                            <h3 class="music-lesson-area-title">Técnica fundamental</h3>
                            <p class="music-lesson-area-desc">Postura, articulação, escalas e exercícios de base para tocar com menos esforço e mais controle.</p>
                        </div>
                    </li>
                    <li class="music-lesson-area ui-card">
                        <div class="music-lesson-area-icon" aria-hidden="true">R</div>
                        <div class="music-lesson-area-body">
                            <h3 class="music-lesson-area-title">Repertório clássico e popular</h3>
                            <p class="music-lesson-area-desc">Peças escolhidas pelo nível e interesse do aluno — do clássico ao popular brasileiro e internacional.</p>
                        </div>
                    </li>
                    <li class="music-lesson-area ui-card">
                        <div class="music-lesson-area-icon" aria-hidden="true">J</div>
                        <div class="music-lesson-area-body">
                            <h3 class="music-lesson-area-title">Jazz e improvisação</h3>
                            <p class="music-lesson-area-desc">Linguagem jazzística, voicings, modos e construção de solos — para quem quer entender a harmonia além dos acordes básicos.</p>
                        </div>
                    </li>
                    <li class="music-lesson-area ui-card">
                        <div class="music-lesson-area-icon" aria-hidden="true">H</div>
                        <div class="music-lesson-area-body">
                            <h3 class="music-lesson-area-title">Teoria e harmonia</h3>
                            <p class="music-lesson-area-desc">Leitura, escala, intervalos, progressões e análise harmônica — contextualizados no instrumento.</p>
                        </div>
                    </li>
                    <li class="music-lesson-area ui-card">
                        <div class="music-lesson-area-icon" aria-hidden="true">C</div>
                        <div class="music-lesson-area-body">
                            <h3 class="music-lesson-area-title">Composição</h3>
                            <p class="music-lesson-area-desc">Do motivo ao desenvolvimento — como criar e expandir ideias musicais com intenção e estrutura.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ── Your Rhythm Studio ── -->
    <section class="music-studio site-section" id="music-studio" aria-labelledby="music-studio-heading">
        <div class="site-shell">
            <div class="music-studio-inner" data-reveal>

                <div class="music-studio-header">
                    <span class="music-studio-live-badge" aria-label="Em produção">
                        <span class="music-studio-live-dot" aria-hidden="true"></span>
                        em produção
                    </span>
                    <h2 class="music-studio-name" id="music-studio-heading">Your Rhythm Studio</h2>
                    <p class="music-studio-tagline">
                        Plataforma de aprendizado musical com repertório estruturado, missões progressivas
                        e o piano virtual embutido — desenvolvida e mantida por mim.
                    </p>
                    <a class="ui-button ui-button--ghost music-studio-link"
                       href="https://yourrhythmstudio.com.br"
                       target="_blank"
                       rel="noopener noreferrer">
                        Acessar a plataforma →
                    </a>
                </div>

                <ul class="music-studio-features" role="list">
                    <li class="music-studio-feature">
                        <div class="music-studio-feature-icon" aria-hidden="true">🎯</div>
                        <h3 class="music-studio-feature-title">Missões progressivas</h3>
                        <p class="music-studio-feature-desc">Sistema de missões que guia o aluno do básico ao avançado com objetivos claros a cada etapa.</p>
                    </li>
                    <li class="music-studio-feature">
                        <div class="music-studio-feature-icon" aria-hidden="true">🎹</div>
                        <h3 class="music-studio-feature-title">Piano virtual integrado</h3>
                        <p class="music-studio-feature-desc">O mesmo teclado que você vê acima, contextualizado dentro de exercícios e repertório da plataforma.</p>
                    </li>
                    <li class="music-studio-feature">
                        <div class="music-studio-feature-icon" aria-hidden="true">📚</div>
                        <h3 class="music-studio-feature-title">Repertório curado</h3>
                        <p class="music-studio-feature-desc">Peças organizadas por nível e estilo, com partituras e contexto histórico para cada obra.</p>
                    </li>
                    <li class="music-studio-feature">
                        <div class="music-studio-feature-icon" aria-hidden="true">📈</div>
                        <h3 class="music-studio-feature-title">Progresso acompanhado</h3>
                        <p class="music-studio-feature-desc">Visualização do histórico de estudo, metas concluídas e próximos passos de aprendizado.</p>
                    </li>
                </ul>

            </div>
        </div>
    </section>

    <!-- ── CTA ── -->
    <section class="music-cta site-section" aria-labelledby="music-cta-heading">
        <div class="site-shell">
            <div class="music-cta-inner" data-reveal>
                <span class="ui-kicker">Próximo passo</span>
                <h2 class="ui-title" id="music-cta-heading" style="font-size: var(--step-2);">
                    Vamos começar <br>a tocar.
                </h2>
                <p class="ui-description" style="margin-inline: auto;">
                    Para aulas, composições sob encomenda ou simplesmente para conversar sobre música.
                </p>
                <div class="ui-actions music-cta-actions">
                    <a class="ui-button ui-button--primary"
                       asp-controller="Home"
                       asp-action="Contact">
                        Entrar em contato
                    </a>
                    <a class="ui-button ui-button--ghost" href="#music-compositions">
                        Ouvir composições
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/music-piano.js" asp-append-version="true"></script>
}
