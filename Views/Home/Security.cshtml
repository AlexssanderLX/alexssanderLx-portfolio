@model IReadOnlyList<ClientBlog.Models.CtfCase>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Security";
    ViewData["Description"] = ViewData["Description"] ?? "TryHackMe CTFs, reports and practical security notes by Alexssander LX.";
    var cases = Model.OrderBy(ctf => ctf.Order).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/security.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/experience.css" asp-append-version="true" />
}

<div class="security-page security-lab-page experience-page experience-page--security" data-experience-page>
    <section class="sec-lab site-section experience-section" id="sec-ctf" aria-labelledby="sec-lab-heading">
        <div class="site-shell">
            <div class="sec-lab-head experience-section-head" data-reveal>
                <span class="ui-kicker">CTF Lab</span>
                <h1 class="ui-title experience-title-sm" id="sec-lab-heading">Security cases.</h1>
                <p class="ui-description">
                    Hands-on labs, reports and takeaways.
                </p>
            </div>

            <div class="sec-lab-orbit" data-stagger-group aria-label="Security CTF cases">
                @{
                    var caseIndex = 0;
                }
                @foreach (var ctf in cases)
                {
                    caseIndex++;
                    var sideClass = caseIndex % 2 == 0 ? "sec-lab-card--right" : "sec-lab-card--left";
                    var hardClass = ctf.DifficultyClass == "hard" ? "sec-lab-card--hard" : "";
                    var featuredClass = ctf.IsFeatured ? "sec-lab-card--featured" : "";
                    var shortText = !string.IsNullOrWhiteSpace(ctf.Learning) ? ctf.Learning : ctf.Scenario;

                    <article class="sec-lab-card @sideClass @hardClass @featuredClass ui-card"
                             data-depth-static
                             aria-label="@ctf.Name">
                        @if (ctf.DifficultyClass == "hard")
                        {
                            <span class="sec-lab-bolt sec-lab-bolt--one" aria-hidden="true"></span>
                            <span class="sec-lab-bolt sec-lab-bolt--two" aria-hidden="true"></span>
                            <span class="sec-lab-bolt sec-lab-bolt--three" aria-hidden="true"></span>
                        }

                        <span class="sec-lab-node" aria-hidden="true">@caseIndex.ToString("00")</span>

                        <div class="sec-lab-media">
                            @if (!string.IsNullOrEmpty(ctf.ImagePath))
                            {
                                <img src="@Url.Content(ctf.ImagePath)"
                                     alt="@ctf.ImageAlt"
                                     loading="lazy"
                                     decoding="async" />
                            }
                            else
                            {
                                <span aria-hidden="true">@ctf.Name.Substring(0, Math.Min(2, ctf.Name.Length)).ToUpperInvariant()</span>
                            }
                        </div>

                        <div class="sec-lab-content">
                            <div class="sec-lab-topline">
                                <span>@ctf.Platform</span>
                                <span class="sec-lab-difficulty sec-lab-difficulty--@ctf.DifficultyClass">@ctf.Difficulty</span>
                            </div>

                            <h2 class="sec-lab-name">@ctf.Name</h2>
                            <p class="sec-lab-copy">@shortText</p>

                            @if (ctf.Tags.Any())
                            {
                                <ul class="sec-lab-tags" aria-label="Tags for @ctf.Name">
                                    @foreach (var tag in ctf.Tags.Take(3))
                                    {
                                        <li><span class="ui-badge">@tag</span></li>
                                    }
                                </ul>
                            }

                            <div class="sec-lab-actions">
                                <a class="sec-lab-link sec-lab-link--primary" href="@ctf.Url" target="_blank" rel="noopener noreferrer">
                                    Open CTF
                                </a>
                                @if (!string.IsNullOrWhiteSpace(ctf.ReportPdfPath))
                                {
                                    <a class="sec-lab-link"
                                       asp-controller="Home"
                                       asp-action="CtfReport"
                                       asp-route-slug="@ctf.Slug">
                                        View report
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/experience-motion.js" asp-append-version="true"></script>
}
