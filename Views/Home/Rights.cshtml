@{
    ViewData["Title"] = "Rights";
}

<section class="rights-page">
    <header class="rights-hero">
        <p class="kicker">RIGHTS</p>
        <h1 class="title">Portfolio rights and content ownership.</h1>
        <p class="subtitle">
            This portfolio, its written content, visual identity, project presentation, images,
            and personal materials belong to Alexssander Ferreira de Almeida unless otherwise stated.
        </p>
    </header>

    <div class="rights-grid">
        <article class="card card-hover rights-card">
            <h2>Ownership</h2>
            <p>
                The structure, text, personal branding, screenshots, project descriptions, and original materials
                published here are protected as part of my personal and professional portfolio.
            </p>
        </article>

        <article class="card card-hover rights-card">
            <h2>Project References</h2>
            <p>
                External platforms, challenge names, tools, and technologies are referenced only to describe my studies,
                work, and learning path. Their trademarks and materials remain owned by their respective owners.
            </p>
        </article>

        <article class="card card-hover rights-card">
            <h2>Use Restrictions</h2>
            <p>
                Do not copy, redistribute, impersonate, sell, or reuse this portfolio content, images, or personal
                presentation without permission. Sharing links to the public website is allowed.
            </p>
        </article>

        <article class="card card-hover rights-card">
            <h2>Contact</h2>
            <p>
                For permission requests, professional contact, or questions about content usage,
                contact me through the official contact page.
            </p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Contact</a>
        </article>
    </div>
</section>
