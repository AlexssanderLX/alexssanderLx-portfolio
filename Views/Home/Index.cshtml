@{
    ViewData["Title"] = "Home";
}

<section class="landing-page" id="home">
    <section class="landing-hero" aria-labelledby="home-title">
        <div class="hero-content" data-reveal>
            <p class="brand-kicker">
                <span aria-hidden="true"></span>
                Developer / Hacker / Pianist
            </p>

            <h1 id="home-title">
                I build systems with structure,
                <strong>automation and security thinking.</strong>
            </h1>

            <p class="hero-summary">
                I am Alexssander LX, a backend-focused developer with 2 years solving real problems
                through C#, ASP.NET Core, Python automation, AI workflows, web security practice and piano discipline.
            </p>

            <div class="hero-actions" aria-label="Primary actions">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Projects">
                    Explore work
                    <span aria-hidden="true">-&gt;</span>
                </a>
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Contact">
                    Contact
                    <span aria-hidden="true">mail</span>
                </a>
            </div>
        </div>

        <aside class="identity-panel" data-reveal="right" aria-label="Portrait and identity summary">
            <figure class="portrait-orbit">
                <picture>
                    <source media="(max-width: 700px)" srcset="@Url.Content("~/img/profile-mobile.jpg")">
                    <img src="~/img/Foto de Perfil.jpeg"
                         asp-append-version="true"
                         alt="Portrait of Alexssander Ferreira de Almeida"
                         width="1066"
                         height="1600"
                         loading="eager"
                         decoding="async"
                         fetchpriority="high">
                </picture>
                <span class="brand-seal" aria-hidden="true">
                    <img src="~/img/alx-mark.svg"
                         asp-append-version="true"
                         alt=""
                         width="128"
                         height="128">
                </span>
            </figure>

            <div class="terminal-identity">
                <span>root@@portfolio:~# whoami</span>
                <strong>developer | hacker | pianist</strong>
                <p>build clear systems &middot; automate workflows &middot; protect applications</p>
            </div>
        </aside>
    </section>

    <section class="signal-strip" aria-label="Portfolio highlights" data-reveal>
        <article>
            <span>2+</span>
            <p>Years building practical systems</p>
        </article>
        <article>
            <span>10+</span>
            <p>Projects, APIs and automations</p>
        </article>
        <article>
            <span>7</span>
            <p>CTF labs mapped in the portfolio</p>
        </article>
        <article>
            <span>24/7</span>
            <p>Learning loop: code, security and music</p>
        </article>
    </section>

    <section class="landing-section" aria-labelledby="value-title">
        <div class="section-heading" data-reveal>
            <p class="brand-kicker"><span aria-hidden="true"></span> Core value</p>
            <h2 id="value-title">What I bring into a product</h2>
            <p>
                A compact mix of backend engineering, automation, offensive analysis and creative consistency.
            </p>
        </div>

        <div class="capability-grid">
            <article class="capability-card" data-reveal>
                <span class="capability-icon">&lt;/&gt;</span>
                <h3>Backend systems</h3>
                <p>C#, ASP.NET Core, APIs, MVC, Razor Pages, EF Core, SQL modeling and maintainable business logic.</p>
            </article>

            <article class="capability-card" data-reveal>
                <span class="capability-icon">PY</span>
                <h3>Python automation</h3>
                <p>Scripts, data processing, repetitive task automation, integrations and AI-assisted workflows.</p>
            </article>

            <article class="capability-card" data-reveal>
                <span class="capability-icon">SEC</span>
                <h3>Security mindset</h3>
                <p>Recon, enumeration, Burp Suite, injection testing and defensive decisions before problems become real.</p>
            </article>
        </div>
    </section>

    <section class="work-preview" aria-labelledby="work-title">
        <div class="section-heading" data-reveal>
            <p class="brand-kicker"><span aria-hidden="true"></span> Selected work</p>
            <h2 id="work-title">Real projects, not placeholders</h2>
        </div>

        <div class="work-grid">
            <article class="work-card featured-work" data-reveal>
                <span class="work-badge">Product</span>
                <h3>ZeroPaper</h3>
                <p>Restaurant SaaS with QR ordering, kitchen flow, printing and operational routines.</p>
                <a asp-controller="Home" asp-action="Projects" asp-fragment="dev">View developer projects</a>
            </article>

            <article class="work-card" data-reveal>
                <span class="work-badge">Automation</span>
                <h3>StoreFlow</h3>
                <p>Internal store workflow for shortage records, daily routines and cleaner operational control.</p>
                <a asp-controller="Home" asp-action="Projects" asp-fragment="dev">See workflow</a>
            </article>

            <article class="work-card" data-reveal>
                <span class="work-badge">Security</span>
                <h3>CTF / Pentest</h3>
                <p>TryHackMe labs organized as missions: injection, RCE, enumeration and privilege escalation.</p>
                <a asp-controller="Home" asp-action="Projects" asp-fragment="pentest">Open security track</a>
            </article>
        </div>
    </section>

    <section class="method-panel" aria-labelledby="method-title" data-reveal>
        <div>
            <p class="brand-kicker"><span aria-hidden="true"></span> Method</p>
            <h2 id="method-title">Understand, structure, build, harden.</h2>
            <p>
                I prefer simple execution with depth: understand the real problem, design the workflow,
                build with clarity and harden the result through tests, review and security thinking.
            </p>
        </div>

        <ol class="method-steps" aria-label="Work process">
            <li><span>01</span> Understand the constraints</li>
            <li><span>02</span> Structure the architecture</li>
            <li><span>03</span> Build the useful version</li>
            <li><span>04</span> Harden and improve</li>
        </ol>
    </section>

    <section class="landing-cta" data-reveal aria-label="Contact call to action">
        <div>
            <p class="brand-kicker"><span aria-hidden="true"></span> Next signal</p>
            <h2>Let's build something useful with clarity and impact.</h2>
        </div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Start a conversation</a>
    </section>
</section>
