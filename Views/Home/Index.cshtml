@{
    ViewData["Title"] = "Início";
    ViewData["Description"] = "Alexssander LX cria produtos digitais, aplicações web, SaaS, automações, backend, infraestrutura segura e experiências que conectam tecnologia, segurança e música.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<section class="home-cinematic" id="home">
    <div class="home-intro" data-home-intro aria-hidden="true">
        <div class="home-intro__grid" aria-hidden="true"></div>
        <div class="home-intro__mark">
            <span class="home-intro__kicker">root@@portfolio:~# init</span>
            <strong>Alexssander <span>LX</span></strong>
            <i></i>
        </div>
    </div>

    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-signal-field" aria-hidden="true">
            <div class="home-signal-card home-signal-card--code" data-floating-card>
                <span>api.flow()</span>
                <strong>C# / Python</strong>
            </div>
            <div class="home-signal-card home-signal-card--security" data-floating-card>
                <span>scan.surface</span>
                <strong>security mindset</strong>
            </div>
            <div class="home-signal-card home-signal-card--music" data-floating-card>
                <span>tempo: steady</span>
                <strong>piano / composition</strong>
            </div>
            <div class="home-signal-card home-signal-card--ux" data-floating-card>
                <span>motion.ready</span>
                <strong>front-end craft</strong>
            </div>
        </div>

        <div class="home-hero__copy" data-reveal data-motion-origin="left">
            <p class="ui-kicker" data-hero-step data-motion-delay="120">Alexssander LX</p>
            <h1 class="ui-title ui-title--hero" id="home-title" data-hero-step data-motion-delay="240">
                Construo produtos digitais completos,
                <span class="ui-gradient-text">da ideia ao deploy seguro.</span>
            </h1>
            <p class="ui-description" data-hero-step data-motion-delay="360">
                Desenvolvimento web, SaaS, backend, automações e segurança aplicada para transformar processos reais
                em sistemas claros, úteis e preparados para evoluir.
            </p>

            <div class="ui-actions" aria-label="Ações principais" data-hero-step data-motion-delay="500">
                <a class="ui-button ui-button--primary" asp-controller="Home" asp-action="Contact">
                    Conversar sobre projeto
                    <span aria-hidden="true">-&gt;</span>
                </a>
                <a class="ui-button ui-button--ghost" href="#areas">
                    Explorar &aacute;reas
                </a>
            </div>
        </div>

        <aside class="home-identity ui-panel" data-reveal="right" data-motion-origin="right" data-depth-panel aria-label="Resumo visual de Alexssander LX">
            <div class="home-identity__halo" aria-hidden="true"></div>
            <figure class="home-portrait">
                <picture>
                    <source media="(max-width: 700px)" srcset="@Url.Content("~/img/profile-mobile.jpg")">
                    <img src="~/img/Foto de Perfil.jpeg"
                         asp-append-version="true"
                         alt="Retrato de Alexssander Ferreira de Almeida"
                         width="1066"
                         height="1600"
                         loading="eager"
                         decoding="async"
                         fetchpriority="high">
                </picture>
            </figure>

            <div class="home-terminal" data-hero-step data-motion-delay="680">
                <span>root@@portfolio:~# build --profile</span>
                <strong>software | automação | segurança aplicada</strong>
                <p>2 anos resolvendo problemas reais com C#, ASP.NET Core, Python, Linux e prática ofensiva.</p>
            </div>
        </aside>
    </section>

    <nav class="home-paths site-section--compact" id="areas" aria-label="Caminhos profissionais" data-home-chapter="paths">
        <div class="site-shell">
            <div class="ui-section-heading" data-reveal data-motion-origin="scale">
                <p class="ui-kicker">Escolha o caminho</p>
                <h2 class="ui-title">A homepage agora funciona como mapa, não como gaveta cheia.</h2>
                <p class="ui-description">
                    Cada área apresenta só o suficiente para orientar o visitante e abrir espaço para páginas internas mais profundas.
                </p>
            </div>

            <div class="home-path-grid" data-motion-sequence="paths">
                <a class="path-card ui-card" asp-controller="Home" asp-action="Development" data-reveal data-motion-origin="bottom-left" data-motion-delay="0" data-depth-panel>
                    <span class="ui-badge">Produtos</span>
                    <h3>Desenvolvimento e SaaS</h3>
                    <p>Aplicações web, backend, integrações e produtos reais como ZeroPaper, LedgerFlow e StoreFlow.</p>
                </a>

                <a class="path-card ui-card" href="#infraestrutura" data-reveal data-motion-origin="left" data-motion-delay="100" data-depth-panel>
                    <span class="ui-badge">Operação</span>
                    <h3>Infraestrutura e automações</h3>
                    <p>Fluxos que conectam código, deploy, VPS, proxy, certificados e processos repetitivos.</p>
                </a>

                <a class="path-card ui-card" asp-controller="Home" asp-action="Security" data-reveal data-motion-origin="right" data-motion-delay="180" data-depth-panel>
                    <span class="ui-badge">Segurança</span>
                    <h3>DevSecOps e pentest</h3>
                    <p>Validação, autenticação, revisão, hardening e aprendizado por CTF aplicado ao desenvolvimento.</p>
                </a>

                <a class="path-card ui-card" asp-controller="Home" asp-action="Music" data-reveal data-motion-origin="bottom-right" data-motion-delay="260" data-depth-panel>
                    <span class="ui-badge">Música</span>
                    <h3>Piano, composição e aulas</h3>
                    <p>Um caminho criativo próprio, preparado para evoluir em experiência musical sem áudio automático.</p>
                </a>
            </div>
        </div>
    </nav>

    <section class="home-chapter site-section" aria-labelledby="build-title" data-home-chapter="projects">
        <div class="site-shell home-chapter__grid">
            <div class="ui-section-heading home-sticky-copy" data-reveal data-motion-origin="left">
                <p class="ui-kicker">Amostra técnica</p>
                <h2 class="ui-title" id="build-title">Front-end como experiência, não apenas tela bonita.</h2>
                <p class="ui-description">
                    Esta home mostra direção visual, responsividade, acessibilidade, performance e narrativa.
                    Os projetos completos vivem nas páginas específicas.
                </p>
                <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Development">
                    Abrir página de desenvolvimento
                </a>
            </div>

            <div class="product-preview-stack" aria-label="Capacidades em destaque" data-motion-sequence="projects">
                <article class="product-preview product-preview--zero" data-reveal="right" data-motion-origin="scale" data-motion-delay="0" data-depth-panel>
                    <div>
                        <span class="ui-badge">Interface</span>
                        <h3>Design responsivo</h3>
                        <p>Layouts que se adaptam ao dispositivo, mantêm hierarquia clara e preservam leitura sem depender de efeito pesado.</p>
                    </div>
                    <span class="product-preview__emblem" aria-hidden="true">&lt;/&gt;</span>
                </article>

                <article class="product-preview" data-reveal="right" data-motion-origin="right" data-motion-delay="130" data-depth-panel>
                    <div>
                        <span class="ui-badge">Qualidade</span>
                        <h3>Performance e acessibilidade</h3>
                        <p>Motion com fallback, reduced motion, conteúdo visível sem JavaScript e animações focadas em transform e opacity.</p>
                    </div>
                    <span class="product-preview__emblem" aria-hidden="true">AA</span>
                </article>

                <article class="product-preview" data-reveal="right" data-motion-origin="bottom-right" data-motion-delay="230" data-depth-panel>
                    <div>
                        <span class="ui-badge">Narrativa</span>
                        <h3>Movimento com propósito</h3>
                        <p>Cards, linhas e pequenos sinais visuais guiam o visitante pelas áreas sem transformar a página em painel confuso.</p>
                    </div>
                    <span class="product-preview__emblem" aria-hidden="true">FX</span>
                </article>
            </div>
        </div>
    </section>

    <section class="home-chapter home-infra site-section" id="infraestrutura" aria-labelledby="infra-title" data-home-chapter="infra">
        <div class="site-shell home-chapter__grid home-chapter__grid--reverse">
            <div class="infra-map ui-panel" data-reveal="left" data-motion-origin="scale" data-motion-sequence="pipeline" aria-label="Fluxo visual de infraestrutura">
                <div class="infra-node" data-pipeline-step>Código</div>
                <div class="infra-line" aria-hidden="true"></div>
                <div class="infra-node" data-pipeline-step>Build</div>
                <div class="infra-line" aria-hidden="true"></div>
                <div class="infra-node" data-pipeline-step>Deploy</div>
                <div class="infra-line" aria-hidden="true"></div>
                <div class="infra-node infra-node--accent" data-pipeline-step>VPS segura</div>
                <div class="infra-grid" aria-hidden="true">
                    <span data-pipeline-step>Nginx</span>
                    <span data-pipeline-step>Kestrel</span>
                    <span data-pipeline-step>HTTPS</span>
                    <span data-pipeline-step>Backup</span>
                </div>
            </div>

            <div class="ui-section-heading" data-reveal data-motion-origin="right">
                <p class="ui-kicker">Infraestrutura por trás</p>
                <h2 class="ui-title" id="infra-title">Interface bonita não sustenta produto sozinha.</h2>
                <p class="ui-description">
                    A base futura deve mostrar também servidor, proxy, certificados, pipeline, deploy, automações e rotina de operação
                    sem transformar a homepage em painel técnico.
                </p>
                <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Contact">
                    Planejar uma automação
                </a>
            </div>
        </div>
    </section>

    <section class="home-chapter site-section" aria-labelledby="security-title" data-home-chapter="focus">
        <div class="site-shell">
            <div class="home-area-header" data-reveal data-motion-origin="scale">
                <p class="ui-kicker">Três áreas, uma mesma disciplina</p>
                <h2 class="ui-title" id="security-title">Código, segurança e música aparecem como camadas do mesmo perfil.</h2>
                <p class="ui-description">
                    A home apresenta a visão geral. Cada trilha abre uma página própria, com detalhes, estudos e projetos sem poluir esta primeira experiência.
                </p>
            </div>

            <div class="home-area-board" aria-label="Trilhas principais do portfolio">
                <article class="home-focus-card home-focus-card--dev ui-card" data-reveal data-motion-origin="bottom-left" data-motion-delay="0" data-depth-panel>
                    <div class="home-focus-card__hud" aria-hidden="true">
                        <span>01</span>
                        <i></i>
                    </div>
                    <div class="home-focus-card__topline" aria-hidden="true">
                        <span>route:/dev</span>
                        <span>build-ready</span>
                    </div>
                    <div class="home-area-orb home-area-orb--dev" aria-hidden="true">
                        <span>&lt;/&gt;</span>
                    </div>
                    <span class="ui-badge">Desenvolvimento</span>
                    <h3>Construir sistemas claros e úteis.</h3>
                    <p>C#, ASP.NET Core, Python, automações, APIs, banco de dados e deploy com pensamento de produto.</p>
                    <div class="home-skill-line" aria-label="Progresso visual de desenvolvimento">
                        <span class="home-skill-line__fill home-skill-line__fill--dev"></span>
                    </div>
                    <ul class="home-focus-metrics" aria-label="Resumo de desenvolvimento">
                        <li><strong>2+</strong><span>anos</span></li>
                        <li><strong>APIs</strong><span>backend</span></li>
                        <li><strong>AI</strong><span>automação</span></li>
                    </ul>
                    <div class="home-focus-command" aria-hidden="true">
                        <span>&gt;</span> ship clean systems --with automation
                    </div>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Development">
                        Abrir desenvolvimento
                    </a>
                </article>

                <article class="home-focus-card home-focus-card--security ui-card" data-reveal data-motion-origin="scale" data-motion-delay="120" data-depth-panel>
                    <div class="home-focus-card__hud" aria-hidden="true">
                        <span>02</span>
                        <i></i>
                    </div>
                    <div class="home-focus-card__topline" aria-hidden="true">
                        <span>route:/security</span>
                        <span>attack-surface</span>
                    </div>
                    <div class="home-area-orb home-area-orb--security" aria-hidden="true">
                        <span>+</span>
                    </div>
                    <span class="ui-badge">Segurança aplicada</span>
                    <h3>Pensar como atacante para construir melhor.</h3>
                    <p>CTFs, enumeração, análise de falhas, validação, autenticação e hardening entrando no ciclo de desenvolvimento.</p>
                    <ul class="home-focus-metrics" aria-label="Resumo de segurança">
                        <li><strong>CTF</strong><span>labs</span></li>
                        <li><strong>OWASP</strong><span>web</span></li>
                        <li><strong>Linux</strong><span>infra</span></li>
                    </ul>
                    <div class="home-skill-line" aria-label="Progresso visual de seguranca">
                        <span class="home-skill-line__fill home-skill-line__fill--security"></span>
                    </div>
                    <div class="home-focus-command" aria-hidden="true">
                        <span>&gt;</span> enumerate weak-points --before release
                    </div>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Security">
                        Abrir segurança
                    </a>
                </article>

                <article class="home-focus-card home-focus-card--music ui-card" data-reveal data-motion-origin="bottom-right" data-motion-delay="220" data-depth-panel>
                    <div class="home-focus-card__hud" aria-hidden="true">
                        <span>03</span>
                        <i></i>
                    </div>
                    <div class="home-focus-card__topline" aria-hidden="true">
                        <span>route:/music</span>
                        <span>creative-discipline</span>
                    </div>
                    <div class="home-area-orb home-area-orb--music" aria-hidden="true">
                        <span>&#9834;</span>
                    </div>
                    <span class="ui-badge">Música e ensino</span>
                    <h3>Disciplina criativa também molda produto.</h3>
                    <p>Piano, composição, estudo estruturado e percepção musical como prática de constância, ritmo e expressão.</p>
                    <ul class="home-focus-metrics" aria-label="Resumo de música">
                        <li><strong>Piano</strong><span>base</span></li>
                        <li><strong>Jazz</strong><span>harmonia</span></li>
                        <li><strong>2025</strong><span>obras</span></li>
                    </ul>
                    <div class="home-skill-line" aria-label="Progresso visual de musica">
                        <span class="home-skill-line__fill home-skill-line__fill--music"></span>
                    </div>
                    <div class="home-focus-command" aria-hidden="true">
                        <span>&gt;</span> practice rhythm --compose with intent
                    </div>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Music">
                        Abrir música
                    </a>
                </article>
            </div>
        </div>
    </section>

    <section class="home-final-cta site-section--compact" aria-labelledby="final-title" data-home-chapter="final">
        <div class="site-shell">
            <div class="home-final-cta__panel ui-panel" data-reveal data-motion-origin="scale" data-depth-panel>
                <div>
                    <p class="ui-kicker">Próximo passo</p>
                    <h2 class="ui-title" id="final-title">Vamos transformar uma ideia, rotina ou problema em sistema?</h2>
                    <p class="ui-description">
                        Traga o contexto. Eu ajudo a estruturar o caminho entre produto, automação, infraestrutura e segurança.
                    </p>
                </div>
                <div class="ui-actions">
                    <a class="ui-button ui-button--primary" asp-controller="Home" asp-action="Contact">Entrar em contato</a>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="About">Ver perfil</a>
                </div>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/js/home-motion.js" asp-append-version="true"></script>
}
