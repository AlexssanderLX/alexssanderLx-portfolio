@{
    ViewData["Title"] = "About";
}

<section class="about-page">
    <header class="about-hero">
        <div class="about-copy">
            <p class="kicker"><span aria-hidden="true"></span> About</p>
            <h1>
                I build with structure, think with clarity,
                <strong>and improve through practice.</strong>
            </h1>
            <p class="subtitle">
                I am a backend developer with 2 years of experience solving real problems through
                C#, ASP.NET Core, Python automation, AI workflows, security practice and creative discipline from piano.
            </p>

            <div class="about-tags" aria-label="Main skills">
                <span>C# / ASP.NET Core</span>
                <span>Python automation</span>
                <span>Security Web</span>
                <span>AI workflows</span>
                <span>Linux VPS</span>
                <span>Piano and composition</span>
            </div>
        </div>

        <aside class="about-terminal" aria-label="About terminal summary">
            <div class="terminal-dots" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <pre><code>root@@alex-lx:~# whoami
developer | hacker | pianist

&gt; mission
build clear systems
automate repetitive work
protect applications

&gt; focus
deliver real value
with discipline and clarity</code></pre>
            <img src="~/img/alx-mark.svg"
                 asp-append-version="true"
                 alt=""
                 aria-hidden="true"
                 width="128"
                 height="128">
        </aside>
    </header>

    <section class="about-section" aria-labelledby="about-expect-title">
        <div class="about-card-grid">
            <article class="about-card">
                <span class="about-icon">&lt;/&gt;</span>
                <h2 id="about-expect-title">What I build</h2>
                <p>Robust web applications, APIs, workflows, automation scripts and projects that solve real problems with clarity and performance.</p>
                <small>Focus on backend and automation</small>
            </article>

            <article class="about-card glow-card">
                <span class="about-icon">SEC</span>
                <h2>How I think</h2>
                <p>I like to understand limits, failure points and attack surface. This mindset improves how I design, implement and protect each solution.</p>
                <small>Security and quality from the start</small>
            </article>

            <article class="about-card">
                <span class="about-icon">AI</span>
                <h2>What to expect</h2>
                <p>Continuous growth, strong ownership, practical delivery and the ability to use AI and automation to move faster with control.</p>
                <small>Discipline, focus and evolution</small>
            </article>
        </div>
    </section>

    <section class="about-section" aria-labelledby="core-areas-title">
        <p class="kicker"><span aria-hidden="true"></span> Core areas</p>
        <h2 class="section-title" id="core-areas-title">Where I create value</h2>

        <div class="core-grid">
            <article class="core-card">
                <span>DEV</span>
                <h3>Development</h3>
                <ul>
                    <li>Projects in C# and ASP.NET Core</li>
                    <li>REST APIs and defined architecture</li>
                    <li>Databases and module design</li>
                    <li>Readable, testable and sustainable code</li>
                </ul>
                <strong>01</strong>
            </article>

            <article class="core-card green">
                <span>PY</span>
                <h3>Python and automation</h3>
                <ul>
                    <li>Scripts for repetitive tasks</li>
                    <li>Data and ETL-style processing</li>
                    <li>Workflow and integration automation</li>
                    <li>Machine learning experimentation</li>
                </ul>
                <strong>02</strong>
            </article>

            <article class="core-card">
                <span>SEC</span>
                <h3>Security</h3>
                <ul>
                    <li>Authentication, sessions and validation</li>
                    <li>Burp Suite and vulnerability analysis</li>
                    <li>Enumeration and lab practice</li>
                    <li>Security as a project standard</li>
                </ul>
                <strong>03</strong>
            </article>
        </div>
    </section>

    <section class="about-section" aria-labelledby="process-title">
        <p class="kicker"><span aria-hidden="true"></span> How I work</p>
        <h2 class="section-title" id="process-title">Simple process, consistent execution</h2>

        <div class="process-line">
            <article>
                <span>1</span>
                <h3>Understand</h3>
                <p>I analyze the real problem, restrictions and objective before building.</p>
            </article>
            <article>
                <span>2</span>
                <h3>Structure</h3>
                <p>I design the workflow, responsibilities and future maintenance path.</p>
            </article>
            <article>
                <span>3</span>
                <h3>Build</h3>
                <p>I implement with clarity, tests, review and continuous improvement.</p>
            </article>
            <article>
                <span>4</span>
                <h3>Harden</h3>
                <p>I validate, refactor and reduce risk to deliver reliable solutions.</p>
            </article>
        </div>
    </section>

    <section class="about-section faq-section" aria-labelledby="faq-title">
        <p class="kicker"><span aria-hidden="true"></span> FAQ</p>
        <h2 class="section-title" id="faq-title">Common questions</h2>

        <div class="faq-list">
            <details>
                <summary>What kind of opportunity am I looking for?</summary>
                <p>Junior, trainee, internship or collaboration opportunities where backend, automation, security thinking and practical learning matter.</p>
            </details>
            <details>
                <summary>Why include security in a developer portfolio?</summary>
                <p>Because it improves how I build. Thinking like an attacker helps me make better decisions about validation, boundaries, authentication and safer defaults.</p>
            </details>
            <details>
                <summary>How do I show my work?</summary>
                <p>Through real projects, public code, visible progress, technical practice and the ability to explain decisions clearly.</p>
            </details>
        </div>
    </section>

    <section class="about-cta">
        <span class="about-icon">&gt;_</span>
        <div>
            <h2>Let's build something useful together.</h2>
            <p>I am open to challenges, collaborations and opportunities that generate real impact.</p>
        </div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Projects">View projects</a>
        <a class="btn" asp-controller="Home" asp-action="Contact">Contact</a>
    </section>
</section>
