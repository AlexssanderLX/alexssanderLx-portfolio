@{
    ViewData["Title"] = "Profile";
    ViewData["Description"] = "Technical profile of Alexssander LX: full-stack .NET, DevSecOps, application security, infrastructure and automation.";
}

<section class="about-page">
    <section class="about-hero" aria-labelledby="about-title" data-reveal>
        <div class="about-copy">
            <p class="ui-kicker">technical profile</p>
            <h1 id="about-title">
                Full-stack .NET, security mindset,
                <span>production delivery.</span>
            </h1>
            <p>
                Computer Science student and full-stack developer building real SaaS, business systems and internal tools with C#, ASP.NET Core, React, SQL databases, Docker, Linux and applied security.
            </p>

            <div class="about-hero-actions" aria-label="Profile links">
                <a class="ui-button ui-button--primary" asp-controller="Home" asp-action="Development">View projects</a>
                <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Security">Security cases</a>
            </div>
        </div>

        <aside class="about-terminal-card" aria-label="Terminal summary">
            <div class="about-terminal-bar" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <pre><code>alex@portfolio:~$ profile --focus
role: full-stack .NET developer
core: ASP.NET Core | React | PostgreSQL
ops: Docker | Linux | Nginx | CI/CD
sec: OWASP | Burp | Nmap | hardening
mode: build -> deploy -> validate</code></pre>
        </aside>
    </section>

    <section class="about-signal-grid" aria-label="Technical highlights" data-reveal>
        <article class="about-signal-card about-signal-card--primary">
            <span>01</span>
            <strong>Real production work</strong>
            <p>SaaS, ERP/CRM flows, local systems and operational tools used beyond portfolio demos.</p>
        </article>
        <article class="about-signal-card">
            <span>02</span>
            <strong>Backend as source of truth</strong>
            <p>Business rules, auth, tenant isolation, validation and integrations stay controlled server-side.</p>
        </article>
        <article class="about-signal-card">
            <span>03</span>
            <strong>Security connects to code</strong>
            <p>Offensive practice is translated into safer architecture, access control and remediation decisions.</p>
        </article>
    </section>

    <section class="about-section" aria-labelledby="about-focus-title" data-reveal>
        <div class="about-section-head">
            <p class="ui-kicker">capability map</p>
            <h2 id="about-focus-title">Where the work fits</h2>
        </div>

        <div class="about-focus-grid">
            <article class="about-focus-card">
                <div class="about-command">dotnet build</div>
                <h3>Backend and APIs</h3>
                <p>C#, .NET 8, ASP.NET Core, MVC/Razor, REST APIs, EF Core, RBAC and business-rule modeling.</p>
            </article>

            <article class="about-focus-card">
                <div class="about-command">ui.compose</div>
                <h3>Frontend systems</h3>
                <p>React, Next.js, TypeScript, Vite, Razor, Tailwind CSS and responsive product interfaces.</p>
            </article>

            <article class="about-focus-card">
                <div class="about-command">data.sync</div>
                <h3>Data and integrations</h3>
                <p>PostgreSQL, MySQL/MariaDB, SQLite, MongoDB, migrations, REST APIs, webhooks and payments.</p>
            </article>

            <article class="about-focus-card">
                <div class="about-command">ops.release</div>
                <h3>DevOps and infrastructure</h3>
                <p>Docker, GitHub Actions, SSH deploys, Linux VPS, Nginx, Kestrel, systemd, HTTPS and Cloudflare.</p>
            </article>

            <article class="about-focus-card">
                <div class="about-command">sec.audit</div>
                <h3>AppSec and pentest</h3>
                <p>OWASP, IDOR/BAC, SQL Injection, SSTI, Burp Suite, Nmap, ffuf, Wireshark and CTF reports.</p>
            </article>

            <article class="about-focus-card">
                <div class="about-command">worker.run</div>
                <h3>Automation and AI</h3>
                <p>Python, shell workflows, background services, AI integrations, data transformation and process automation.</p>
            </article>
        </div>
    </section>

    <section class="about-console-section" aria-labelledby="about-stack-title" data-reveal>
        <div>
            <p class="ui-kicker">stack snapshot</p>
            <h2 id="about-stack-title">Tools I use to ship</h2>
        </div>

        <div class="about-console-grid">
            <article class="about-mini-terminal">
                <span>$ backend</span>
                <p>C# / ASP.NET Core / EF Core / Razor / REST</p>
            </article>
            <article class="about-mini-terminal">
                <span>$ frontend</span>
                <p>React / Next.js / TypeScript / Tailwind / Vite</p>
            </article>
            <article class="about-mini-terminal">
                <span>$ database</span>
                <p>PostgreSQL / MySQL / MariaDB / SQLite / MongoDB</p>
            </article>
            <article class="about-mini-terminal">
                <span>$ delivery</span>
                <p>Docker / GitHub Actions / Linux / Nginx / Cloudflare</p>
            </article>
            <article class="about-mini-terminal">
                <span>$ security</span>
                <p>OWASP / Burp Suite / Nmap / ffuf / Wireshark</p>
            </article>
            <article class="about-mini-terminal">
                <span>$ quality</span>
                <p>Clean Architecture / SOLID / TDD / Git Flow / PRs</p>
            </article>
        </div>
    </section>

    <section class="about-flow" aria-labelledby="about-flow-title" data-reveal>
        <div class="about-section-head">
            <p class="ui-kicker">working loop</p>
            <h2 id="about-flow-title">A direct delivery path</h2>
        </div>

        <ol class="about-flow-list">
            <li>
                <span>01</span>
                <strong>Scope</strong>
                <p>Understand the business workflow, risk and technical boundary.</p>
            </li>
            <li>
                <span>02</span>
                <strong>Architect</strong>
                <p>Shape modules, data, auth, integrations and deployment path.</p>
            </li>
            <li>
                <span>03</span>
                <strong>Build</strong>
                <p>Implement backend, UI, persistence, automation and tests.</p>
            </li>
            <li>
                <span>04</span>
                <strong>Harden</strong>
                <p>Validate access control, secrets, logs, rollback and production behavior.</p>
            </li>
        </ol>
    </section>

    <section class="about-cta" data-reveal>
        <div>
            <p class="ui-kicker">next command</p>
            <h2>Build, secure and ship useful systems.</h2>
        </div>
        <div class="about-hero-actions">
            <a class="ui-button ui-button--primary" asp-controller="Home" asp-action="Contact">Start a conversation</a>
            <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Development">See work</a>
        </div>
    </section>
</section>
