@model IReadOnlyList<ClientBlog.Models.ProjectItem>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Development";
    ViewData["Description"] = ViewData["Description"] ?? "Web products, SaaS platforms, automation and applied infrastructure. From interface to server, development with security built in.";
    var activeProjects = Model.Where(project => project.Status != "coming-soon").OrderBy(project => project.Order).ToList();
    var pendingProjects = Model.Where(project => project.Status == "coming-soon").OrderBy(project => project.Order).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/development.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/experience.css" asp-append-version="true" />
}

<div class="development-page experience-page experience-page--dev" data-experience-page>
    <section class="dev-hero experience-hero" aria-labelledby="dev-h1">
        <div class="experience-orbitals" aria-hidden="true">
            <span class="experience-signal-card signal-card--one">api.flow()<strong>C# / Python</strong></span>
            <span class="experience-signal-card signal-card--two">build --release<strong>ASP.NET Core</strong></span>
            <span class="experience-signal-card signal-card--three">deploy:vps<strong>Nginx / HTTPS</strong></span>
        </div>
        <div class="site-shell">
            <div class="dev-hero-inner experience-hero-grid">
                <div class="experience-copy-panel" data-reveal data-motion-origin="left">
                    <span class="ui-kicker">Product Engineering / Automation / Infrastructure</span>
                    <h1 class="ui-title" id="dev-h1">
                        Systems that move from <span class="ui-gradient-text">idea to production.</span>
                    </h1>
                    <p class="ui-description">
                        Backend-focused engineering for real products: modular platforms, APIs, automation scripts, Linux deployments and secure workflows that remain clear after the first release.
                    </p>
                    <div class="ui-actions">
                        <a class="ui-button ui-button--primary" href="#dev-projects">View product work</a>
                        <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Contact">Discuss a build</a>
                    </div>
                </div>

                <aside class="experience-score-card ui-card" data-reveal data-motion-origin="right" data-depth-panel aria-label="Development score">
                    <div class="experience-score-top">
                        <span class="experience-score-icon" aria-hidden="true">&lt;/&gt;</span>
                        <span class="experience-score-status">BUILD READY</span>
                    </div>
                    <h2>Product engineering</h2>
                    <p>2+ years building web systems, automation and secure delivery paths.</p>
                    <div class="experience-xp">
                        <span>XP 1280 / 1500</span>
                        <span>Level 21</span>
                    </div>
                    <div class="experience-xp-bar experience-xp-bar--85" aria-hidden="true"><span></span></div>
                    <ul class="experience-metric-grid" role="list">
                        <li><strong>12</strong><span>Projects</span></li>
                        <li><strong>34</strong><span>Studies</span></li>
                        <li><strong>28</strong><span>Day streak</span></li>
                        <li><strong>8</strong><span>Badges</span></li>
                    </ul>
                </aside>
            </div>
        </div>
    </section>

    <section class="dev-capabilities site-section experience-section" id="dev-capabilities" aria-labelledby="dev-cap-heading">
        <div class="site-shell">
            <div class="dev-section-head experience-section-head" data-reveal>
                <span class="ui-kicker">Core Craft</span>
                <h2 class="ui-title experience-title-sm" id="dev-cap-heading">What the stack is used for.</h2>
                <p class="ui-description">
                    The focus is not listing tools. It is showing what those tools make possible in a real product lifecycle.
                </p>
            </div>

            <ul class="dev-capabilities-grid experience-card-grid" role="list">
                <li class="dev-capability-card ui-card" data-reveal data-depth-panel>
                    <div class="dev-capability-icon" aria-hidden="true">API</div>
                    <h3 class="dev-capability-title">Backends and APIs</h3>
                    <p class="dev-capability-benefit">C#, ASP.NET Core, Web API, MVC and EF Core for business rules, authentication, data flow and maintainable modules.</p>
                </li>
                <li class="dev-capability-card ui-card" data-reveal data-depth-panel>
                    <div class="dev-capability-icon" aria-hidden="true">PY</div>
                    <h3 class="dev-capability-title">Automation scripts</h3>
                    <p class="dev-capability-benefit">Python and shell workflows to reduce repetitive work, transform data and connect services with pragmatic automation.</p>
                </li>
                <li class="dev-capability-card ui-card" data-reveal data-depth-panel>
                    <div class="dev-capability-icon" aria-hidden="true">OPS</div>
                    <h3 class="dev-capability-title">Delivery and infrastructure</h3>
                    <p class="dev-capability-benefit">Linux, Ubuntu Server, VPS, Nginx, Kestrel, Certbot, HTTPS and Cloudflare for controlled production releases.</p>
                </li>
                <li class="dev-capability-card ui-card" data-reveal data-depth-panel>
                    <div class="dev-capability-icon" aria-hidden="true">SEC</div>
                    <h3 class="dev-capability-title">Secure product thinking</h3>
                    <p class="dev-capability-benefit">Burp Suite, Nmap, ffuf, dirsearch and CTF practice applied to validation, auth, hardening and safer releases.</p>
                </li>
            </ul>
        </div>
    </section>

    <section class="dev-projects site-section experience-section" id="dev-projects" aria-labelledby="dev-proj-heading">
        <div class="site-shell">
            <div class="dev-section-head experience-section-head" data-reveal>
                <span class="ui-kicker">Product Modules</span>
                <h2 class="ui-title experience-title-sm" id="dev-proj-heading">Projects with operational weight.</h2>
                <p class="ui-description">
                    These projects focus on workflows that need to keep working outside the portfolio: ordering, records, fiscal routines, students and process visibility.
                </p>
            </div>

            <div class="dev-projects-grid experience-project-grid">
                @foreach (var project in activeProjects)
                {
                    <article class="dev-project-card ui-card @(project.IsFeatured ? "dev-project-card--featured" : "")" data-reveal data-depth-panel aria-label="@project.Name">
                        @if (!string.IsNullOrEmpty(project.ImagePath))
                        {
                            <img src="@project.ImagePath"
                                 asp-append-version="true"
                                 alt="@project.ImageAlt"
                                 class="dev-project-emblem"
                                 width="88"
                                 height="88"
                                 loading="lazy"
                                 decoding="async" />
                        }
                        else
                        {
                            <div class="dev-project-emblem dev-project-emblem--fallback" aria-hidden="true">@project.Name.Substring(0, 2).ToUpperInvariant()</div>
                        }
                        <div class="dev-project-body">
                            <span class="dev-project-rank">@project.Rank</span>
                            <h3 class="dev-project-name">@project.Name</h3>
                            <p class="dev-project-summary">@project.Description</p>
                            @if (project.Tags.Any())
                            {
                                <ul class="dev-project-tags" aria-label="Tags for @project.Name">
                                    @foreach (var tag in project.Tags.Take(5))
                                    {
                                        <li><span class="ui-badge">@tag</span></li>
                                    }
                                </ul>
                            }
                            <details class="experience-details">
                                <summary>Project details</summary>
                                <p>@project.Summary</p>
                            </details>
                            <div class="dev-project-links">
                                @if (!string.IsNullOrEmpty(project.ProjectUrl))
                                {
                                    <a class="dev-project-link dev-project-link--primary" href="@project.ProjectUrl" target="_blank" rel="noopener noreferrer">Live product</a>
                                }
                                @if (!string.IsNullOrEmpty(project.GitHubUrl))
                                {
                                    <a class="dev-project-link" href="@project.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (pendingProjects.Any())
            {
                <div class="experience-pending-row" data-reveal>
                    @foreach (var project in pendingProjects)
                    {
                        <article class="dev-project-card dev-project-card--pending ui-card" data-depth-panel>
                            <span class="dev-project-pending-badge">In development</span>
                            <h3 class="dev-project-name">@project.Name</h3>
                            <p class="dev-project-summary">@project.Summary</p>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="dev-infra site-section experience-section" id="dev-infra" aria-labelledby="dev-infra-heading">
        <div class="site-shell">
            <div class="experience-split">
                <div class="dev-section-head experience-section-head" data-reveal data-motion-origin="left">
                    <span class="ui-kicker">Operational Layer</span>
                    <h2 class="ui-title experience-title-sm" id="dev-infra-heading">Strong interfaces need strong delivery paths.</h2>
                    <p class="ui-description">
                        Source control, build flow, Linux hosting, reverse proxy, certificates, backup habits and automation that reduces repetitive work.
                    </p>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="Contact">Discuss automation</a>
                </div>

                <div class="dev-pipeline experience-circuit ui-card" data-reveal data-motion-origin="right" data-depth-panel role="list" aria-label="Delivery pipeline">
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Code</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Build</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Deploy</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Secure VPS</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Nginx</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Kestrel</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">HTTPS</span></div>
                    <div class="dev-pipeline-step" role="listitem"><span class="dev-pipeline-label">Backup</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="dev-security-layer site-section experience-section" id="dev-security" aria-labelledby="dev-sec-heading">
        <div class="site-shell">
            <div class="dev-section-head experience-section-head" data-reveal>
                <span class="ui-kicker">Secure Build Loop</span>
                <h2 class="ui-title experience-title-sm" id="dev-sec-heading">Security is part of the build, not a final checklist.</h2>
            </div>
            <ul class="dev-security-grid experience-card-grid" role="list">
                <li class="dev-security-item ui-card" data-reveal data-depth-panel><span class="dev-security-num">01</span><h3 class="dev-security-title">Validate input</h3><p class="dev-security-desc">Reduce injection, malformed data and unsafe assumptions at the boundary.</p></li>
                <li class="dev-security-item ui-card" data-reveal data-depth-panel><span class="dev-security-num">02</span><h3 class="dev-security-title">Control identity</h3><p class="dev-security-desc">Authentication and authorization reviewed as a full user journey.</p></li>
                <li class="dev-security-item ui-card" data-reveal data-depth-panel><span class="dev-security-num">03</span><h3 class="dev-security-title">Harden delivery</h3><p class="dev-security-desc">Secrets stay out of code, HTTPS is enforced and server exposure is minimized.</p></li>
                <li class="dev-security-item ui-card" data-reveal data-depth-panel><span class="dev-security-num">04</span><h3 class="dev-security-title">Review continuously</h3><p class="dev-security-desc">CTF practice and threat modeling shape better product decisions before release.</p></li>
            </ul>
        </div>
    </section>

    <section class="dev-cta site-section experience-section" aria-labelledby="dev-cta-heading">
        <div class="site-shell">
            <div class="dev-cta-inner experience-final-card" data-reveal data-depth-panel>
                <span class="ui-kicker">Next Step</span>
                <h2 class="ui-title experience-title-sm" id="dev-cta-heading">A practical builder for product, automation and security problems.</h2>
                <p class="ui-description">For product ideas, workflow automation, technical review or secure deployment, this portfolio is a starting point for a focused conversation.</p>
                <div class="ui-actions dev-cta-actions">
                    <a class="ui-button ui-button--primary" asp-controller="Home" asp-action="Contact">Get in touch</a>
                    <a class="ui-button ui-button--ghost" asp-controller="Home" asp-action="About">View profile</a>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/experience-motion.js" asp-append-version="true"></script>
}
