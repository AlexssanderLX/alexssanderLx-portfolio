@model IReadOnlyList<ClientBlog.Models.ProjectItem>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Development";
    ViewData["Description"] = ViewData["Description"] ?? "Web products, SaaS platforms, automation and applied infrastructure. From interface to server, development with security built in.";
    var activeProjects = Model.Where(project => project.Status != "coming-soon").OrderBy(project => project.Order).ToList();
    var pendingProjects = Model.Where(project => project.Status == "coming-soon").OrderBy(project => project.Order).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/development.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/experience.css" asp-append-version="true" />
}

<div class="development-page experience-page experience-page--dev" data-experience-page>
    <section class="dev-projects site-section experience-section" id="dev-projects" aria-labelledby="dev-proj-heading">
        <div class="site-shell">
            <div class="dev-section-head experience-section-head dev-route-head" data-reveal>
                <span class="ui-kicker">Projects</span>
                <h1 class="ui-title experience-title-sm" id="dev-proj-heading">Product map.</h1>
                <p class="ui-description">
                    Real products and active modules, arranged as checkpoints for quick scanning.
                </p>
            </div>

            <div class="dev-route-map" data-stagger-group aria-label="Development project map">
                @{
                    var checkpointIndex = 0;
                }
                @foreach (var project in activeProjects)
                {
                    checkpointIndex++;
                    var sideClass = checkpointIndex % 2 == 0 ? "dev-route-card--right" : "dev-route-card--left";
                    var featuredClass = project.IsFeatured ? "dev-route-card--featured" : "";
                    var previewClass = !string.IsNullOrEmpty(project.PreviewImagePath) ? "dev-route-card--with-preview" : "";

                    <article class="dev-route-card @sideClass @featuredClass @previewClass ui-card" data-reveal data-depth-panel aria-label="@project.Name">
                        @if (!string.IsNullOrEmpty(project.PreviewImagePath))
                        {
                            <img class="dev-route-preview"
                                 src="@Url.Content(project.PreviewImagePath)"
                                 alt=""
                                 loading="lazy"
                                 decoding="async" />
                            <span class="dev-route-preview-overlay" aria-hidden="true"></span>
                        }
                        <span class="dev-route-node" aria-hidden="true">@checkpointIndex.ToString("00")</span>
                        <div class="dev-route-media">
                            @if (!string.IsNullOrEmpty(project.ImagePath))
                            {
                                <img src="@project.ImagePath"
                                     asp-append-version="true"
                                     alt="@project.ImageAlt"
                                     width="76"
                                     height="76"
                                     loading="lazy"
                                     decoding="async" />
                            }
                            else
                            {
                                <span aria-hidden="true">@project.Name.Substring(0, 2).ToUpperInvariant()</span>
                            }
                        </div>
                        <div class="dev-route-content">
                            <span class="dev-project-rank">@project.Rank</span>
                            <h3 class="dev-project-name">@project.Name</h3>
                            <p class="dev-project-summary">@project.Description</p>
                            @if (project.Tags.Any())
                            {
                                <ul class="dev-project-tags" aria-label="Tags for @project.Name">
                                    @foreach (var tag in project.Tags.Take(3))
                                    {
                                        <li><span class="ui-badge">@tag</span></li>
                                    }
                                </ul>
                            }
                            <div class="dev-project-links">
                                @if (!string.IsNullOrEmpty(project.ProjectUrl))
                                {
                                    <a class="dev-project-link dev-project-link--primary" href="@project.ProjectUrl" target="_blank" rel="noopener noreferrer">Open</a>
                                }
                                @if (!string.IsNullOrEmpty(project.GitHubUrl))
                                {
                                    <a class="dev-project-link" href="@project.GitHubUrl" target="_blank" rel="noopener noreferrer">Code</a>
                                }
                            </div>
                        </div>
                    </article>
                }
                @foreach (var project in pendingProjects)
                {
                    checkpointIndex++;
                    var sideClass = checkpointIndex % 2 == 0 ? "dev-route-card--right" : "dev-route-card--left";

                    <article class="dev-route-card dev-route-card--pending @sideClass ui-card" data-reveal data-depth-panel aria-label="@project.Name">
                        <span class="dev-route-node" aria-hidden="true">@checkpointIndex.ToString("00")</span>
                        <div class="dev-route-media dev-route-media--pending" aria-hidden="true">
                            <span>@project.Name.Substring(0, 2).ToUpperInvariant()</span>
                        </div>
                        <div class="dev-route-content">
                            <span class="dev-project-pending-badge">Next checkpoint</span>
                            <h3 class="dev-project-name">@project.Name</h3>
                            <p class="dev-project-summary">@project.Summary</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/experience-motion.js" asp-append-version="true"></script>
}
