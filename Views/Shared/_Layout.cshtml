<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alexssander LX portfolio: backend development, Python automation, AI workflows, security labs, and music." />
    <title>@ViewData["Title"] - Alexssanderlx</title>
    <link rel="icon" type="image/svg+xml" href="~/img/alx-mark.svg" asp-append-version="true" />
    <link rel="shortcut icon" type="image/svg+xml" href="~/img/alx-mark.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClientBlog.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header-fixed header-tech">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container header-inner">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index" aria-label="Home">
                    <img src="~/img/alx-mark.svg" asp-append-version="true" class="logo-img" alt="Alexssander LX logo" width="128" height="128" />
                    <span class="brand-wordmark">Alexssander <strong>LX</strong></span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav header-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Projects">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Projects" asp-fragment="pentest">CTF / Security</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Projects" asp-fragment="music">Music</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cta" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="header-offset"></div>

    <main class="outer-frame">
        <div class="inner-frame">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-fixed">
        <span>&#169; 2026 Alexssander LX Portfolio</span>
        <a asp-controller="Home" asp-action="Rights">Rights</a>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
