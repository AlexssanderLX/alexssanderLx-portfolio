<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Alexssander LX portfolio: desenvolvimento web, SaaS, automações, infraestrutura, segurança aplicada e música.")" />
    <meta property="og:title" content="@ViewData["Title"] - Alexssander LX" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Produtos digitais, backend, automações, infraestrutura segura, segurança aplicada e música.")" />
    <meta property="og:type" content="website" />
    <title>@ViewData["Title"] - Alexssanderlx</title>
    <link rel="icon" type="image/svg+xml" href="~/img/alx-mark.svg" asp-append-version="true" />
    <link rel="shortcut icon" type="image/svg+xml" href="~/img/alx-mark.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClientBlog.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header-fixed header-tech">
        <nav class="site-nav" aria-label="Primary navigation">
            <div class="container header-inner">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index" aria-label="Home">
                    <img src="~/img/alx-mark.svg" asp-append-version="true" class="logo-img" alt="Alexssander LX logo" width="128" height="128" />
                    <span class="brand-wordmark">Alexssander <strong>LX</strong></span>
                </a>

                <ul class="nav-list header-nav desktop-nav">
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="About">Perfil</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="Development">Dev</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="Security">Security</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="Music">Music</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="Contact">Contato</a></li>
                    <li><a class="nav-link cta" asp-controller="Home" asp-action="Contact">Iniciar projeto</a></li>
                </ul>

                <button class="nav-toggle" type="button"
                        data-nav-toggle
                        aria-controls="mobileNav"
                        aria-expanded="false"
                        aria-label="Open navigation menu">
                    <span class="nav-toggle-line" aria-hidden="true"></span>
                    <span class="nav-toggle-line" aria-hidden="true"></span>
                    <span class="nav-toggle-line" aria-hidden="true"></span>
                </button>

                <div class="mobile-menu" id="mobileNav" data-mobile-menu>
                    <ul class="nav-list header-nav">
                        <li><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                        <li><a class="nav-link" asp-controller="Home" asp-action="About">Perfil</a></li>
                        <li><a class="nav-link" asp-controller="Home" asp-action="Development">Desenvolvimento</a></li>
                        <li><a class="nav-link" asp-controller="Home" asp-action="Security">Segurança</a></li>
                        <li><a class="nav-link" asp-controller="Home" asp-action="Music">Música</a></li>
                        <li><a class="nav-link" asp-controller="Home" asp-action="Contact">Contato</a></li>
                        <li><a class="nav-link cta" asp-controller="Home" asp-action="Contact">Iniciar projeto</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="header-offset"></div>

    <main class="outer-frame">
        <div class="inner-frame">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-fixed">
        <div class="footer-map" aria-label="Footer navigation">
            <span>&#169; 2026 Alexssander LX</span>
            <a asp-controller="Home" asp-action="Development">Dev</a>
            <a asp-controller="Home" asp-action="Security">Security</a>
            <a asp-controller="Home" asp-action="Music">Music</a>
            <a asp-controller="Home" asp-action="About">Profile</a>
            <a asp-controller="Home" asp-action="Contact">Contact</a>
            <a asp-controller="Home" asp-action="Rights">Rights</a>
            <a asp-controller="Home" asp-action="Projects">Archive</a>
        </div>
    </footer>

    <script src="~/js/capabilities.js" asp-append-version="true"></script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    <script src="~/js/reveal.js" asp-append-version="true"></script>
    <script src="~/js/ambient.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
